{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "browser-diagnostics",
  "account_id": "b9851cc811f85bf0187b87488e2fd2f8",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-13",
  "routes": [
    {
      "pattern": "browser.9ba.in",
      "custom_domain": true
    },
    {
      "pattern": "ua.9ba.in",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "08099462fac04538b9f82be6c194debf"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
