{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "browser-diagnostics",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
